# Copy to .env (gitignored) and add your own people — one LW_PROFILE_<n> per person.
# Format: Name | YYYY-MM-DD HH:MM (local birth time) | City [| lat | lon | UTC offset]
# Without lat/lon/offset they are filled in from the offline city list.
LW_PROFILE_1="Example Person | 2000-01-01 12:00 | Chennai"
# LW_PROFILE_2="Exact Coordinates | 1985-05-05 05:05 | Ottapalam | 10.77 | 76.38 | 5.5"
